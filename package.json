{
  "name": "@esauflores/zoom-dl",
  "version": "1.0.0",
  "description": "Download Zoom cloud recordings — including passcode-protected ones and ones with the download button disabled",
  "license": "MIT",
  "bin": {
    "zoom-dl": "src/zoom-dl.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check && tsc --noEmit",
    "check:fix": "oxlint --fix && oxfmt --write",
    "test": "vitest run",
    "zoom-dl": "bun run src/zoom-dl.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "got": "^16.0.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}
