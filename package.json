{
  "name": "@esauflores/zoom-dl",
  "version": "1.0.1",
  "description": "Download Zoom cloud recordings — including passcode-protected ones and ones with the download button disabled",
  "homepage": "https://github.com/esauflores/zoom-dl#readme",
  "bugs": {
    "url": "https://github.com/esauflores/zoom-dl/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esauflores/zoom-dl.git"
  },
  "bin": {
    "zoom-dl": "dist/zoom-dl.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "oxlint && oxfmt --check && tsc --noEmit",
    "check:fix": "oxlint --fix && oxfmt --write",
    "prepack": "npm run build",
    "test": "vitest run",
    "zoom-dl": "bun run src/zoom-dl.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "got": "^16.0.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}
